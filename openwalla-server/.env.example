# Router running Netify
OPENWALLA_NETIFY_HOST=192.168.1.1
OPENWALLA_NETIFY_PORT=7150
OPENWALLA_ROUTER_LAN_IP=192.168.1.1

# Openwalla Server
OPENWALLA_API_PORT=8080
OPENWALLA_RETENTION_HOURS=24
OPENWALLA_API_TOKEN=

# Web dashboard authentication. Set either PASSWORD or PASSWORD_HASH.
OPENWALLA_UI_USERNAME=admin
OPENWALLA_UI_PASSWORD=
OPENWALLA_UI_PASSWORD_HASH=
OPENWALLA_SESSION_SECRET=
OPENWALLA_SESSION_HOURS=24
OPENWALLA_AUTH_MAX_FAILURES=5
OPENWALLA_AUTH_WINDOW_SECONDS=900
OPENWALLA_AUTH_BAN_SECONDS=3600
# Enable only when requests can reach this service through your trusted proxy.
OPENWALLA_AUTH_TRUST_PROXY=false
# Enable when the dashboard is served exclusively over HTTPS.
OPENWALLA_AUTH_SECURE_COOKIE=false

# Optional outbound reverse tunnel
OPENWALLA_TUNNEL_SSH_PORT=2222
OPENWALLA_TUNNEL_USER=openwalla
# Existing external Docker network shared with Traefik
OPENWALLA_PROXY_NETWORK=proxy
OPENWALLA_TUNNEL_STATUS_HOST=openwalla-tunnel
OPENWALLA_TUNNEL_HTTP_PORT=10080
OPENWALLA_TUNNEL_REMOTE_SSH_PORT=10022
